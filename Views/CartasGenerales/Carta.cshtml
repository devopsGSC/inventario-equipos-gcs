@model CartaGeneral
@{
  ViewData["Title"] = "Carta General";
  string tipo = Model.TipoResponsable;
  string controllerDetalle = tipo switch { "Empleado" => "Empleados", "MiembroExterno" => "MiembrosExternos", "Grupo" => "Grupos", _ => "Empleados" };
  int idDetalle = Model.EmpleadoId ?? Model.MiembroExternoId ?? Model.GrupoId ?? 0;
  int totalEquipos = ViewBag.TotalEquipos ?? 0;
  int totalPerifericos = ViewBag.TotalPerifericos ?? 0;
}

<div class="page-header">
  <div>
    <a asp-controller="Navegacion" asp-action="Volver" class="text-muted" style="text-decoration:none;font-size:13px">
      <i class="bi bi-arrow-left"></i> @Model.NombreResponsable
    </a>
    <div class="page-title" style="margin-top:4px">Carta general de activos</div>
  </div>
  <a asp-action="DescargarCarta" asp-route-id="@Model.Id" class="btn btn-primary">
    <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
  </a>
</div>

<div class="card" style="max-width:700px">
  <div class="card-body">
    <div style="background:var(--navy);color:var(--text);border-radius:10px;padding:20px 24px;margin-bottom:20px">
      <div style="font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text3);margin-bottom:4px">
        Resumen de activos actuales
      </div>
      <div style="font-size:18px;font-weight:600">@Model.NombreResponsable</div>
      <div style="font-size:13px;color:var(--text2)">@totalEquipos equipo(s) — @totalPerifericos periférico(s)</div>
    </div>

    @{
      bool tieneFirma = !string.IsNullOrEmpty(Model.FirmaEmpleado);
      string bgOk = "var(--green-bg)", txtOk = "var(--green-text)", bgPend = "var(--amber-bg)", txtPend = "var(--amber-text)";
    }

    <div class="form-label" style="margin-bottom:10px">Trazabilidad</div>
    <div style="display:flex;align-items:center;gap:4px;margin-bottom:16px;flex-wrap:wrap">
      <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:20px;background:@bgOk;color:@txtOk;font-size:12.5px;font-weight:600">
        <i class="bi bi-check-circle-fill"></i> Asignada
      </span>
      <i class="bi bi-arrow-right-short" style="font-size:20px;color:var(--dark-text2)"></i>
      <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:20px;background:@(tieneFirma ? bgOk : bgPend);color:@(tieneFirma ? txtOk : txtPend);font-size:12.5px;font-weight:600">
        <i class="bi @(tieneFirma ? "bi-check-circle-fill" : "bi-hourglass-split")"></i> @(tieneFirma ? "Firmada" : "Firma pendiente")
      </span>
      <i class="bi bi-arrow-right-short" style="font-size:20px;color:var(--dark-text2)"></i>
      <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:20px;background:@(Model.EntregaCompletada ? bgOk : bgPend);color:@(Model.EntregaCompletada ? txtOk : txtPend);font-size:12.5px;font-weight:600">
        <i class="bi @(Model.EntregaCompletada ? "bi-check-circle-fill" : "bi-hourglass-split")"></i> @(Model.EntregaCompletada ? "Entregada" : "Entrega pendiente")
      </span>
    </div>

    <div class="text-muted" style="margin-bottom:6px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <span>
        Asignada por <strong>@(Model.CreadoPorUsuario?.NombreCompleto ?? Model.CreadoPorUsuario?.Email ?? "—")</strong>
        el @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm").
      </span>
      @if (!Model.EntregaCompletada)
      {
        <form method="post" asp-action="TomarComoPreparador" asp-route-id="@Model.Id" style="display:inline">
          <button type="submit" class="btn btn-secondary btn-sm" title="Si vas a ser quien entregue y firme esta carta, reclamala para que tu firma de Tecnología aparezca en el PDF">
            <i class="bi bi-person-check"></i> Tomar como preparador
          </button>
        </form>
      }
    </div>

    @if (!tieneFirma)
    {
      <div class="text-muted" style="margin-bottom:16px">
        Todavía no tiene firma de @Model.NombreResponsable. Si no está presente, generá un link para que firme a distancia desde su celular.
      </div>
    }
    else
    {
      <div class="text-muted" style="margin-bottom:16px">Firma de @Model.NombreResponsable registrada.</div>
    }

    <div class="divider"></div>

    @if (Model.EntregaCompletada)
    {
      <div class="text-muted" style="margin-bottom:16px">
        Entregado por @(Model.EntregadoPorUsuario?.NombreCompleto ?? "—")@(Model.FechaEntrega.HasValue ? $" el {Model.FechaEntrega.Value:dd/MM/yyyy HH:mm}" : "").
      </div>
    }
    else
    {
      <div style="margin-bottom:16px">
        <div class="text-muted" style="margin-bottom:8px">
          Pendiente de entrega física. Marcala como entregada cuando la entregues para que quede registrado quién lo hizo.
        </div>
        <form method="post" asp-action="MarcarEntrega" asp-route-id="@Model.Id">
          <label class="form-label">Nota de entrega (opcional)</label>
          <textarea name="notaEntrega" class="form-control" rows="2" placeholder="Ej: Entregada y firmada en sitio."></textarea>
          <button type="submit" class="btn btn-primary" style="margin-top:10px">
            <i class="bi bi-check-circle"></i> Marcar como entregada
          </button>
        </form>
      </div>
    }

    <div class="gap-2">
      @if (string.IsNullOrEmpty(Model.FirmaEmpleado))
      {
        <a asp-action="GenerarLinkFirma" asp-route-id="@Model.Id" class="btn btn-secondary">
          <i class="bi bi-link-45deg"></i> Generar link de firma remota
        </a>
      }
      <a asp-controller="@controllerDetalle" asp-action="Details" asp-route-id="@idDetalle" class="btn btn-secondary">
        Ver detalle
      </a>
    </div>
  </div>
</div>
