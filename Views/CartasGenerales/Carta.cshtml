@model CartaGeneral
@{
  ViewData["Title"] = "Carta General";
  string tipo = Model.TipoResponsable;
  string controllerDetalle = tipo switch { "Empleado" => "Empleados", "MiembroExterno" => "MiembrosExternos", "Grupo" => "Grupos", _ => "Empleados" };
  int idDetalle = Model.EmpleadoId ?? Model.MiembroExternoId ?? Model.GrupoId ?? 0;
  int totalEquipos = ViewBag.TotalEquipos ?? 0;
  int totalPerifericos = ViewBag.TotalPerifericos ?? 0;
}

<div class="page-header">
  <div>
    <a asp-controller="Navegacion" asp-action="Volver" class="text-muted" style="text-decoration:none;font-size:13px">
      <i class="bi bi-arrow-left"></i> @Model.NombreResponsable
    </a>
    <div class="page-title" style="margin-top:4px">Carta general de activos</div>
  </div>
  <a asp-action="DescargarCarta" asp-route-id="@Model.Id" class="btn btn-primary">
    <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
  </a>
</div>

<div class="card" style="max-width:700px">
  <div class="card-body">
    <div class="alert alert-success">
      <i class="bi bi-check-circle-fill"></i>
      Carta preparada el @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm").
    </div>

    <div style="background:var(--navy);color:var(--text);border-radius:10px;padding:20px 24px;margin-bottom:20px">
      <div style="font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text3);margin-bottom:4px">
        Resumen de activos actuales
      </div>
      <div style="font-size:18px;font-weight:600">@Model.NombreResponsable</div>
      <div style="font-size:13px;color:var(--text2)">@totalEquipos equipo(s) — @totalPerifericos periférico(s)</div>
    </div>

    @if (string.IsNullOrEmpty(Model.FirmaEmpleado))
    {
      <div class="alert alert-warning">
        <i class="bi bi-pen"></i> Esta carta todavía no tiene firma de @Model.NombreResponsable.
        Si no está presente, generá un link para que firme a distancia desde su celular.
      </div>
    }

    <div class="divider"></div>

    @if (Model.EntregaCompletada)
    {
      <div class="alert alert-success" style="margin-bottom:16px">
        <i class="bi bi-check-circle-fill"></i>
        Entregado por @(Model.EntregadoPorUsuario?.NombreCompleto ?? "—")@(Model.FechaEntrega.HasValue ? $" el {Model.FechaEntrega.Value:dd/MM/yyyy HH:mm}" : "").
      </div>
      <div class="gap-2">
        <a asp-action="DescargarCarta" asp-route-id="@Model.Id" class="btn btn-primary">
          <i class="bi bi-download"></i> Descargar carta PDF
        </a>
      </div>
    }
    else
    {
      <div class="alert alert-warning" style="margin-bottom:16px">
        <i class="bi bi-hourglass-split"></i>
        Pendiente de entrega física. Marcala como entregada cuando la entregues para que quede registrado quién lo hizo.
      </div>
      <form method="post" asp-action="MarcarEntrega" asp-route-id="@Model.Id" style="margin-bottom:16px">
        <label class="form-label">Nota de entrega (opcional)</label>
        <textarea name="notaEntrega" class="form-control" rows="2" placeholder="Ej: Entregada y firmada en sitio."></textarea>
        <button type="submit" class="btn btn-primary" style="margin-top:10px">
          <i class="bi bi-check-circle"></i> Marcar como entregada
        </button>
      </form>
    }

    <div class="gap-2">
      @if (string.IsNullOrEmpty(Model.FirmaEmpleado))
      {
        <a asp-action="GenerarLinkFirma" asp-route-id="@Model.Id" class="btn btn-secondary">
          <i class="bi bi-link-45deg"></i> Generar link de firma remota
        </a>
      }
      <a asp-controller="@controllerDetalle" asp-action="Details" asp-route-id="@idDetalle" class="btn btn-secondary">
        Ver detalle
      </a>
    </div>
  </div>
</div>
