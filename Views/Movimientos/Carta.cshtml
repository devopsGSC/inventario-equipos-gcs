@model Movimiento
@{ 
  ViewData["Title"] = Model.TipoMovimiento == "Prestamo" ? "Carta de Préstamo" : "Carta de Compromiso";
  bool esPrestamo = Model.TipoMovimiento == "Prestamo";
}

<div class="page-header">
  <div>
    <a asp-controller="Navegacion" asp-action="Volver" class="text-muted" style="text-decoration:none;font-size:13px">
      <i class="bi bi-arrow-left"></i> @Model.Equipo?.NombreEquipo
    </a>
    <div class="page-title" style="margin-top:4px">
      @(esPrestamo ? "Carta de préstamo generada" : "Carta de compromiso generada")
    </div>
  </div>
  <a asp-action="DescargarCarta" asp-route-id="@Model.Id" class="btn btn-primary">
    <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
  </a>
</div>

<div class="card" style="max-width:700px">
  <div class="card-body">
    <div style="background:var(--navy);color:var(--text);border-radius:10px;padding:20px 24px;margin-bottom:20px">
      <div style="font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--text3);margin-bottom:4px">
        @(esPrestamo ? "Préstamo de equipo" : "Asignación de equipo")
      </div>
      <div style="font-size:18px;font-weight:600">@Model.Equipo?.NombreEquipo</div>
      <div style="font-size:13px;color:var(--text2);font-family:'DM Mono',monospace">@Model.Equipo?.NumeroSerie</div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px">
      <div>
        <div class="form-label">Responsable</div>
        <div style="font-weight:600">@Model.NombreResponsable</div>
        <div class="text-muted">@(Model.Empleado?.CodigoEmpleado ?? Model.MiembroExterno?.Organizacion)</div>
      </div>
      <div>
        <div class="form-label">@(Model.Empleado != null ? "Departamento" : Model.MiembroExterno != null ? "Organización" : "Descripción")</div>
        <div>@(Model.Empleado?.Departamento?.Nombre ?? Model.MiembroExterno?.Organizacion ?? Model.Grupo?.Descripcion ?? "—")</div>
      </div>
      <div>
        <div class="form-label">Fecha</div>
        <div>@Model.FechaInicio.ToString("dd/MM/yyyy")</div>
      </div>
      @if (esPrestamo && Model.FechaFinEstimada.HasValue)
      {
        <div>
          <div class="form-label">Devolución estimada</div>
          <div style="color:var(--amber-text);font-weight:500">@Model.FechaFinEstimada.Value.ToString("dd/MM/yyyy")</div>
        </div>
      }
    </div>

    @{
      bool tieneFirma = !string.IsNullOrEmpty(Model.FirmaEmpleado);
      string bgOk = "var(--green-bg)", txtOk = "var(--green-text)", bgPend = "var(--amber-bg)", txtPend = "var(--amber-text)";
    }

    <div class="form-label" style="margin-bottom:10px">Trazabilidad</div>
    <div style="display:flex;align-items:center;gap:4px;margin-bottom:16px;flex-wrap:wrap">
      <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:20px;background:@bgOk;color:@txtOk;font-size:12.5px;font-weight:600">
        <i class="bi bi-check-circle-fill"></i> Asignado
      </span>
      <i class="bi bi-arrow-right-short" style="font-size:20px;color:var(--dark-text2)"></i>
      <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:20px;background:@(tieneFirma ? bgOk : bgPend);color:@(tieneFirma ? txtOk : txtPend);font-size:12.5px;font-weight:600">
        <i class="bi @(tieneFirma ? "bi-check-circle-fill" : "bi-hourglass-split")"></i> @(tieneFirma ? "Firmado" : "Firma pendiente")
      </span>
      <i class="bi bi-arrow-right-short" style="font-size:20px;color:var(--dark-text2)"></i>
      <span style="display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:20px;background:@(Model.EntregaCompletada ? bgOk : bgPend);color:@(Model.EntregaCompletada ? txtOk : txtPend);font-size:12.5px;font-weight:600">
        <i class="bi @(Model.EntregaCompletada ? "bi-check-circle-fill" : "bi-hourglass-split")"></i> @(Model.EntregaCompletada ? "Entregado" : "Entrega pendiente")
      </span>
    </div>

    <div class="text-muted" style="margin-bottom:6px">
      Asignado por <strong>@(Model.CreadoPorUsuario?.NombreCompleto ?? Model.CreadoPorUsuario?.Email ?? "—")</strong>
      el @Model.FechaInicio.ToString("dd/MM/yyyy HH:mm").
    </div>

    @if (!tieneFirma)
    {
      <div class="text-muted" style="margin-bottom:16px">
        Todavía no tiene firma del colaborador. Si @Model.NombreResponsable no está presente, generá un link para que firme a distancia desde su celular.
      </div>
    }
    else
    {
      <div class="text-muted" style="margin-bottom:16px">Firma del colaborador registrada.</div>
    }

    <div class="divider"></div>

    @if (Model.EntregaCompletada)
    {
      <div class="text-muted" style="margin-bottom:16px">
        Entregado por @(Model.EntregadoPorUsuario?.NombreCompleto ?? "—")@(Model.FechaEntrega.HasValue ? $" el {Model.FechaEntrega.Value:dd/MM/yyyy HH:mm}" : "").
      </div>
    }
    else
    {
      <div style="margin-bottom:16px">
        <div class="text-muted" style="margin-bottom:8px">
          Pendiente de entrega física. Marcalo como entregado cuando lo entregues para que quede registrado quién lo hizo.
        </div>
        <form method="post" asp-action="MarcarEntrega" asp-route-id="@Model.Id">
          <label class="form-label">Nota de entrega (opcional)</label>
          <textarea name="notaEntrega" class="form-control" rows="2" placeholder="Ej: Equipo entregado y firmado en sitio."></textarea>
          <button type="submit" class="btn btn-primary" style="margin-top:10px">
            <i class="bi bi-check-circle"></i> Marcar como entregado
          </button>
        </form>
      </div>
    }

    <div class="gap-2">
      @if (string.IsNullOrEmpty(Model.FirmaEmpleado))
      {
        <a asp-action="GenerarLinkFirma" asp-route-id="@Model.Id" class="btn btn-secondary">
          <i class="bi bi-link-45deg"></i> Generar link de firma remota
        </a>
      }
      <a asp-controller="Equipos" asp-action="Details" asp-route-id="@Model.EquipoId" class="btn btn-secondary">
        Ver detalle del equipo
      </a>
    </div>
  </div>
</div>
