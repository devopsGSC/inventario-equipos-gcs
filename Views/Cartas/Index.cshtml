@model List<CartaListItem>
@{
  ViewData["Title"] = "Cartas";
  var totalRegistros = (ViewBag.Paginacion as PaginacionViewModel)?.TotalRegistros ?? Model.Count;
}

<div class="page-header">
  <div class="page-title">Cartas</div>
</div>

<div class="card" style="margin-bottom:20px">
  <div class="card-body" style="padding:14px 20px">
    <form method="get" style="display:flex;gap:10px;flex-wrap:wrap">
      <input type="hidden" name="estado" value="@ViewBag.Estado"/>
      <div class="search-box" style="flex:1;min-width:200px">
        <i class="bi bi-search"></i>
        <input type="text" name="buscar" class="form-control" placeholder="Buscar por responsable..." value="@ViewBag.Buscar"/>
      </div>
      <select name="tipo" class="form-control" style="width:180px">
        <option value="">Todos los tipos</option>
        <option value="Equipo" selected="@(ViewBag.Tipo == "Equipo" ? "selected" : null)">Equipo</option>
        <option value="Periferico" selected="@(ViewBag.Tipo == "Periferico" ? "selected" : null)">Periférico directo</option>
        <option value="General" selected="@(ViewBag.Tipo == "General" ? "selected" : null)">Carta general</option>
      </select>
      <button type="submit" class="btn btn-secondary">Filtrar</button>
      @if (!string.IsNullOrEmpty(ViewBag.Buscar as string) || !string.IsNullOrEmpty(ViewBag.Estado as string) || !string.IsNullOrEmpty(ViewBag.Tipo as string))
      { <a asp-action="Index" class="btn btn-secondary">Limpiar</a> }
    </form>
  </div>
</div>

<div class="card" style="margin-bottom:16px;padding:14px 20px;display:flex;gap:10px;flex-wrap:wrap">
  <a asp-action="Index" class="btn btn-secondary btn-sm @(ViewBag.Estado==null?"btn-active":"")">Todas (@totalRegistros)</a>
  <a asp-action="Index" asp-route-estado="Pendiente" class="btn btn-secondary btn-sm">Pendientes de entrega</a>
  <a asp-action="Index" asp-route-estado="Entregada" class="btn btn-secondary btn-sm">Entregadas</a>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead><tr><th>Tipo</th><th>Responsable</th><th>Detalle</th><th>Fecha</th><th>Estado</th><th>Firma</th><th></th></tr></thead>
      <tbody>
        @foreach (var c in Model)
        {
          <tr>
            <td>
              @{
                var (icono, badge) = c.Tipo switch {
                  "Equipo" => ("bi-laptop", "badge-asignado"),
                  "Periferico" => ("bi-mouse2", "badge-bodega"),
                  _ => ("bi-people", "badge-garantia")
                };
              }
              <span class="badge @badge"><i class="bi @icono"></i> @(c.Tipo == "Periferico" ? "Periférico" : c.Tipo)</span>
            </td>
            <td><a href="@c.LinkVer" style="color:var(--accent);text-decoration:none;font-weight:500">@c.Responsable</a></td>
            <td class="text-muted">@c.Detalle</td>
            <td class="text-muted">@c.Fecha.ToString("dd/MM/yyyy")</td>
            <td>
              @if (c.EntregaCompletada)
              {
                <span class="badge badge-green" title="@(c.FechaEntrega.HasValue ? c.FechaEntrega.Value.ToString("dd/MM/yyyy HH:mm") : "")">
                  <i class="bi bi-check-circle"></i> Entregada@(c.EntregadoPor != null ? $" — {c.EntregadoPor}" : "")
                </span>
              }
              else
              {
                <span class="badge badge-garantia"><i class="bi bi-hourglass-split"></i> Pendiente</span>
              }
            </td>
            <td>
              @if (c.TieneFirma)
              { <span class="badge badge-green"><i class="bi bi-pen"></i> Firmada</span> }
              else
              { <span class="badge badge-bodega">Sin firma</span> }
            </td>
            <td>
              <div class="gap-2">
                <a href="@c.LinkVer" class="btn btn-secondary btn-sm" title="Ver carta"><i class="bi bi-eye"></i></a>
                <a href="@c.LinkDescargar" class="btn btn-secondary btn-sm" title="Descargar PDF"><i class="bi bi-file-earmark-pdf"></i></a>
                @if (c.LinkFirmaRemota != null)
                {
                  <a href="@c.LinkFirmaRemota" class="btn btn-secondary btn-sm" title="Generar link de firma remota"><i class="bi bi-link-45deg"></i></a>
                }
              </div>
            </td>
          </tr>
        }
        @if (!Model.Any())
        { <tr><td colspan="7"><div class="empty-state"><i class="bi bi-file-earmark-text"></i>No hay cartas para mostrar.</div></td></tr> }
      </tbody>
    </table>
  </div>
  <partial name="_Paginacion" model="ViewBag.Paginacion as InventarioTI.ViewModels.PaginacionViewModel"/>
</div>
