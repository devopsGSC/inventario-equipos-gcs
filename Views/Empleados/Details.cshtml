@model Empleado
@using InventarioTI.Models
@{
  ViewData["Title"] = Model.Nombre;
  var equipos            = ViewBag.EquiposActuales as List<Movimiento>       ?? new List<Movimiento>();
  var perifsActuales     = ViewBag.PerifsActuales as List<EquipoPeriferico> ?? new List<EquipoPeriferico>();
  var licenciasActuales  = ViewBag.LicenciasActuales as List<LicenciaAsignacion> ?? new List<LicenciaAsignacion>();
}

<div class="page-header">
  <div>
    <a asp-controller="Navegacion" asp-action="Volver" class="text-muted" style="text-decoration:none;font-size:13px"><i class="bi bi-arrow-left"></i> Empleados</a>
    <div class="page-title" style="margin-top:4px">@Model.Nombre</div>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/Reportes?reporte=todo-empleado&empleadoId=@Model.Id" class="btn btn-secondary">
        <i class="bi bi-file-earmark-text"></i> Ver reporte completo
    </a>
    @if (await PermisoSvc.TienePermiso(User, "movimientos.carta") && (equipos.Any() || perifsActuales.Any()))
    {
      <a asp-controller="CartasGenerales" asp-action="Preparar" asp-route-tipo="empleado" asp-route-id="@Model.Id" class="btn btn-secondary" title="Carta con todos los equipos y periféricos actuales">
        <i class="bi bi-file-earmark-pdf"></i> Carta general
      </a>
    }
    @if (await PermisoSvc.TienePermiso(User, "empleados.editar"))
    {
      <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-pencil"></i> Editar</a>
    }
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
  <div class="card">
    <div class="card-header">
      <div class="card-title">Datos del empleado</div>
      @if (Model.Activo) { <span class="badge badge-green">Activo</span> }
      else { <span class="badge badge-baja">Inactivo</span> }
    </div>
    <div class="card-body">
      <div class="form-grid" style="gap:14px">
        <div>
          <div class="form-label">Código de empleado</div>
          <div style="font-size:14px;font-weight:500;font-family:'DM Mono',monospace">@Model.CodigoEmpleado</div>
        </div>
        <div>
          <div class="form-label">DUI</div>
          <div style="font-size:14px;font-weight:500">@Model.DUI</div>
        </div>
        <div>
          <div class="form-label">Cargo</div>
          <div style="font-size:14px;font-weight:500">@Model.Cargo</div>
        </div>
        <div>
          <div class="form-label">Departamento</div>
          <div style="font-size:14px;font-weight:500">@(Model.Departamento?.Nombre ?? "—")</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title">Equipos actuales</div>
      <div style="display:flex;gap:8px;align-items:center">
        <span class="badge badge-asignado">@equipos.Count en uso</span>
        @if (Model.Activo && (await PermisoSvc.TienePermiso(User, "movimientos.asignar") || await PermisoSvc.TienePermiso(User, "movimientos.prestamo") || await PermisoSvc.TienePermiso(User, "perifericos.asignar") || await PermisoSvc.TienePermiso(User, "licencias.asignar")))
        {
          <a asp-controller="Asignaciones" asp-action="Nueva" asp-route-tipo="empleado" asp-route-id="@Model.Id" class="btn btn-primary btn-sm" title="Asignar equipo, periféricos y/o licencias juntos">
            <i class="bi bi-plus-lg"></i> Asignación
          </a>
        }
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Equipo</th><th>Tipo</th><th>Movimiento</th><th></th></tr></thead>
        <tbody>
          @foreach (var m in equipos)
          {
            <tr>
              <td>
                <a asp-controller="Equipos" asp-action="Details" asp-route-id="@m.EquipoId" style="color:var(--accent);text-decoration:none;font-weight:500">@m.Equipo?.NombreEquipo</a>
                <div class="mono text-muted">@m.Equipo?.NumeroSerie</div>
              </td>
              <td>@m.Equipo?.TipoEquipo?.Nombre</td>
              <td>@m.TipoMovimiento<div class="text-muted">@m.FechaInicio.ToString("dd/MM/yyyy")</div></td>
              <td>
                @if (await PermisoSvc.TienePermiso(User, "movimientos.carta"))
                {
                  <a asp-controller="Movimientos" asp-action="Carta" asp-route-id="@m.Id" class="btn btn-secondary btn-sm" title="Carta con equipo y periféricos de este colaborador">
                    <i class="bi bi-file-earmark-pdf"></i> Carta
                  </a>
                }
              </td>
            </tr>
          }
          @if (!equipos.Any())
          {
            <tr><td colspan="4"><div class="empty-state" style="padding:20px"><i class="bi bi-laptop"></i>Sin equipos asignados.</div></td></tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

@if (perifsActuales.Any())
{
<div style="margin-top:20px">
  <div class="card">
    <div class="card-header">
      <div class="card-title">Periféricos asignados</div>
      <span class="badge badge-asignado">@perifsActuales.Count en uso</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Tipo</th>
            <th>Marca / Modelo</th>
            <th>Número de serie</th>
            <th>Desde</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var ep in perifsActuales)
          {
            <tr>
              <td>@ep.Periferico?.TipoPeriferico?.Nombre</td>
              <td>
                <a asp-controller="Perifericos" asp-action="Details" asp-route-id="@ep.PerifericoId"
                   style="color:var(--accent);text-decoration:none;font-weight:500">
                  @ep.Periferico?.Marca @ep.Periferico?.Modelo
                </a>
              </td>
              <td><span class="mono text-muted">@ep.Periferico?.NumeroSerie</span></td>
              <td>@ep.FechaAsignacion.ToString("dd/MM/yyyy")</td>
              <td>
                <a asp-controller="Perifericos" asp-action="CartaDirecta"
                   asp-route-asignacionId="@ep.Id"
                   class="btn btn-secondary btn-sm">
                  <i class="bi bi-file-earmark-pdf"></i>
                </a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
}

@if (licenciasActuales.Any())
{
<div style="margin-top:20px">
  <div class="card">
    <div class="card-header">
      <div class="card-title">Licencias asignadas</div>
      <span class="badge badge-asignado">@licenciasActuales.Count en uso</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Licencia</th><th>Desde</th></tr></thead>
        <tbody>
          @foreach (var la in licenciasActuales)
          {
            <tr>
              <td>
                <a asp-controller="Licencias" asp-action="Details" asp-route-id="@la.TipoLicenciaId"
                   style="color:var(--accent);text-decoration:none;font-weight:500">@la.TipoLicencia?.Nombre</a>
              </td>
              <td>@la.FechaAsignacion.ToString("dd/MM/yyyy")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
}

